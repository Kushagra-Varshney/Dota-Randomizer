{
	"$schema": "../../node_modules/wrangler/config-schema.json",
	"name": "dota-picker",
	"main": "src/index.ts",
	"compatibility_date": "2026-09-01",
	"observability": {
		"enabled": true
	},
	// The built web app is served as static assets; only /api/* reaches the Worker code.
	"assets": {
		"directory": "../web/dist",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		"run_worker_first": [
			"/api/*"
		]
	},
	// Discord bot (see docs/discord-bot-plan.md). Public values, not secrets: copy them from the
	// Developer Portal. While DISCORD_PUBLIC_KEY is empty the bot route returns 404.
	// DISCORD_GUILD_IDS is a comma-separated allowlist of servers the bot answers in.
	"vars": {
		"DISCORD_APPLICATION_ID": "1560998294338011186",
		"DISCORD_PUBLIC_KEY": "3189edcf2f8ec45938ec7d03ab736400ee2c5bad6f7a95dc9d59c653fa49df07",
		"DISCORD_GUILD_IDS": "1206497134938034196,645534031064334341"
	},
	// Created automatically by the first `wrangler deploy`. The ID isn't a secret; keep it committed.
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "dota-picker",
			"migrations_dir": "migrations",
			"database_id": "07e1da54-7179-46c5-8833-ef8bcb658ce1"
		}
	]
}